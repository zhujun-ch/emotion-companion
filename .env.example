DB_BACKEND=sqlite
SQLITE_PATH=artifacts/demo.sqlite3
APP_HOST=127.0.0.1
APP_PORT=5000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180
EMOTION_MODEL_DIR=artifacts/emotion_cnn

# Three-client demo. Copy to .env and set your own reviewer password.
DEMO_REVIEWER_USERNAME=admin
DEMO_REVIEWER_PASSWORD=
DEMO_DATA_DIR=artifacts

# Browser/Host allowlists. Add the computer's exact LAN IP for mobile testing.
APP_ENV=development
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
APP_TRUSTED_HOSTS=127.0.0.1,localhost,[::1]
# Reviewer endpoints default to this computer only; never use 0.0.0.0/0.
REVIEWER_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
ACCOUNT_TOKEN_TTL_SECONDS=2592000
# Production: clear DEMO_REVIEWER_PASSWORD and point to a protected hash file.
DEMO_REVIEWER_PASSWORD_HASH_FILE=
